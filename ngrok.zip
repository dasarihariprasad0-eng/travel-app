		if (!isConsentSettled) fallbackTimer = setTimeout(settleConsent, CONSENT_FALLBACK_MS);
		scheduleWhenReady();
	}
	if (consentDecisionEvent) window.addEventListener(consentDecisionEvent, settleConsent, { once: true });
	if (isDocumentLoaded) onDocumentLoaded();
	else window.addEventListener("load", onDocumentLoaded, { once: true });
