nk-0 items-center justify-center border focus:outline-hidden focus-visible:ring-4 disabled:cursor-default disabled:opacity-50 aria-disabled:cursor-default aria-disabled:opacity-50 not-disabled:active:scale-97 ease-out transition-transform duration-150 focus-visible:ring-focus-accent not-disabled:hover:bg-neutral-500/10 not-disabled:hover:text-strong border-transparent size-9 text-muted hover:text-strong absolute top-1/2 right-2 -translate-y-1/2 rounded-full" data-appearance="ghost" data-icon-button="true" data-intent="neutral" data-size="md" data-state="closed" aria-label="Copy to clipboard" type="button"><span data-slot="icon-swap" class="inline-grid shrink-0 place-items-center"><span data-slot="icon-swap-item" data-state="active" class="col-start-1 row-start-1 grid place-items-center motion-safe:transition-[opacity,scale,filter] motion-safe:duration-200 motion-safe:ease-out-strong data-state-inactive:opacity-0 motion-safe:data-state-inactive:scale-50 motion-safe:data-state-inactive:blur-[2px] motion-safe:data-state-inactive:duration-150 data-state-inactive:*:[animation-play-state:paused]"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" data-slot="icon svg-only" aria-hidden="true" class="shrink-0 size-5"><path d="M216,32H88a8,8,0,0,0-8,8V80H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H168a8,8,0,0,0,8-8V176h40a8,8,0,0,0,8-8V40A8,8,0,0,0,216,32ZM160,208H48V96H160Zm48-48H176V88a8,8,0,0,0-8-8H96V48H208Z"></path></svg></span><span data-slot="icon-swap-item" data-state="inactive" aria-hidden="true" class="col-start-1 row-start-1 grid place-items-center motion-safe:transition-[opacity,scale,filter] motion-safe:duration-200 motion-safe:ease-out-strong data-state-inactive:opacity-0 motion-safe:data-state-inactive:scale-50 motion-safe:data-state-inactive:blur-[2px] motion-safe:data-state-inactive:duration-150 data-state-inactive:*:[animation-play-state:paused]"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" f